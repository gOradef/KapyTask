<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xviews="clr-namespace:KapyTask.Views.Modals"
             x:Class="KapyTask.Views.Modals.TaskEditModal"
             Title="Задача">
    
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Label Text="Задача" Style="{StaticResource Headline}"/>
            <Border Padding="10">
                <VerticalStackLayout>
                    <!-- Select discipline -->
                    <Picker ItemsSource="{Binding Disciplines}" 
                            SelectedItem="{Binding SelectedDiscipline}" 
                            SelectedIndexChanged="PickerDiscipline_OnSelectedIndexChanged"
                            ItemDisplayBinding="{Binding Name}"
                            Title="Выберите дисциплину" 
                            x:DataType="xviews:TaskEditModal"/>
                    <!-- Select date -->
                    <VerticalStackLayout  x:DataType="xviews:TaskEditModal">
                        <Entry Placeholder="Введите название задачи" Text="{Binding KTask.Name}"/>
                        <Editor Placeholder="Описание задачи (опционально)" AutoSize="TextChanges" Text="{Binding KTask.Description}"/>
                        <VerticalStackLayout Padding="10">
                            <Grid ColumnDefinitions="*, auto">
                                <Label Grid.Column="0" Text="Установить произвольный дедлайн..." VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>
                                <DatePicker Grid.Column="1"
                                            DateSelected="DatePicker_OnCustomDateSelected" 
                                            HorizontalOptions="End"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, auto">
                                <Label Grid.Column="0" Text="Привязять дедлайн к занятию..." VerticalTextAlignment="Center" HorizontalTextAlignment="Start"/>
                                <Picker Grid.Column="1" 
                                        ItemsSource="{Binding SuggestedDeadlines}" 
                                        SelectedItem="{Binding SelectedSuggestedDeadline}" 
                                        HorizontalOptions="End"/>
                            </Grid>
                        </VerticalStackLayout>
                        
                        <!-- Display current deadline -->
                        <HorizontalStackLayout HorizontalOptions="End" Padding="5">
                            <Label Text="Дедлайн: "/>
                            <Label Text="{Binding DisplayedDeadline}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"/>
                            
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <!-- Navigation buttons -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button BackgroundColor="IndianRed" Text="Отмена" Clicked="ButtonClose_OnClicked"/>
                <Button BackgroundColor="DarkSeaGreen" Text="Сохранить" Clicked="ButtonConfirm_OnClicked" VerticalOptions="End"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>