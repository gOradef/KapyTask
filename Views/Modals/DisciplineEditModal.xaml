<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cs="clr-namespace:KapyTask.Views.Modals"
             x:Class="KapyTask.Views.Modals.DisciplineEditModal"
             Title="Дисциплина"
             x:DataType="cs:DisciplineEditModal">
    
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Label Text="Дисциплина" Style="{StaticResource Headline}"/>
            <Border Padding="10">
                <VerticalStackLayout>
                    <Entry Text="{Binding Discipline.Name}" 
                           Placeholder="Название дисциплины"/>
                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                        <Label Text="Цвет дисциплины" 
                               VerticalOptions="Center"/>
                        <Picker Title="Выберите цвет"
                                ItemsSource="{Binding DisciplineColors}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedColor}"
                                WidthRequest="200"/>
                    </HorizontalStackLayout>
                    <BoxView Color="{Binding SelectedColor.Color}" 
                             HeightRequest="40" 
                             CornerRadius="8"
                             Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button BackgroundColor="IndianRed" 
                        Text="Отмена" 
                        Clicked="ButtonClose_OnClicked"/>
                <Button BackgroundColor="DarkSeaGreen" 
                        Text="Сохранить" 
                        Clicked="ButtonConfirm_OnClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>