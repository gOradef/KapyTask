<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KapyTask.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="20">
            <Image
                Source="cat_halo.png"
                HeightRequest="200"
                Aspect="Fill" 
                Margin="-15, -50, -15, -10"
                />

            <Label
                Text="🐈‍⬛ Опмяя-eeeewh учиться 🐈"
                Style="{StaticResource SubHeadline}" />

            <Button
                x:Name="SetTasksToBody"
                Text="Set tasks" 
                Clicked="OnSetTasksClicked"
                HorizontalOptions="Fill" />
            <Label
                x:Name="Body"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
