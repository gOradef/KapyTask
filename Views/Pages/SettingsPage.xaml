<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KapyTask.Views.SettingsPage">

    <NavigationPage.Title>
        Настройки
    </NavigationPage.Title>
    <ScrollView>
        <VerticalStackLayout
            Padding="15"
            Spacing="15">
            <Label Text="Конфигурация" Style="{StaticResource SubHeadline}"/>
            <Border>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="25">
                    <Button Text="Редактировать дисциплины" Clicked="ButtonEditDisciplines_OnClicked"/>
                    <Button Text="Редактировать расписание" Clicked="ButtonEditSchedule_OnClicked"/>
                </VerticalStackLayout>
            </Border>
            <HorizontalStackLayout HorizontalOptions="End">
                <Button Text="About the /dev 🛠️"
                        Clicked="ButtonOpenDevPage_OnClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>