<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KapyTask.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KapyTask.Views"
    Title="KapyTask">

    <TabBar>
        <Tab Title="Текущие" Icon="icons8_home.png">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}"
                          Route="MainPage"/>
        </Tab>
        <Tab Title="Поиск" Icon="icons8_search.png">
            <ShellContent ContentTemplate="{DataTemplate views:SearchPage}"
                          Route="SettingsPage"/>
        </Tab>
        <Tab Title="Настройки" Icon="icons8_settings.png">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}"
                          Route="SettingsPage"/>
        </Tab>
    </TabBar>
</Shell>
